<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/bg_square" android:scaleType="fitXY" />

    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingLeft="8dp" android:paddingRight="8dp" android:paddingTop="8dp" android:paddingBottom="6dp">

        <!-- Battery pill (top) -->
        <FrameLayout android:id="@+id/battery_tile" android:layout_width="60dp" android:layout_height="20dp">
            <ProgressBar android:id="@+id/bat_bar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="20dp"
                android:minHeight="20dp" android:maxHeight="20dp" android:max="100"
                android:indeterminate="false" android:progressDrawable="@drawable/battery_pill" />
            <TextView android:id="@+id/bat_pct" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textColor="#000000" android:textSize="12sp" android:textStyle="bold" />
        </FrameLayout>

        <!-- Analog clock (middle, takes all spare space) -->
        <FrameLayout android:id="@+id/clock_tile" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1">
            <AnalogClock android:id="@+id/clock" android:layout_width="match_parent" android:layout_height="match_parent"
                android:dial="@drawable/clock_dial" android:hand_hour="@drawable/clock_hour"
                android:hand_minute="@drawable/clock_minute" />
        </FrameLayout>

        <!-- City name (up to 2 rows) with invisible flip zones: left half = previous, right half = next -->
        <FrameLayout android:layout_width="match_parent" android:layout_height="44dp">
            <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal" android:gravity="center"
                android:paddingLeft="6dp" android:paddingRight="6dp" android:maxLines="2" android:ellipsize="end"
                android:textColor="@color/widget_fg2" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal">
                <View android:id="@+id/flip_prev" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
                <View android:id="@+id/flip_next" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </FrameLayout>

        <!-- Weather row: ! temps icon wind (tap = AccuWeather) -->
        <LinearLayout android:id="@+id/wx_row" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical|center_horizontal">
            <TextView android:id="@+id/warn" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingRight="4dp" android:text="!" android:textColor="#FFEB00"
                android:textSize="13sp" android:textStyle="bold" android:visibility="gone" />
            <TextView android:id="@+id/temps" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingRight="4dp" android:singleLine="true" android:textColor="@color/widget_fg"
                android:textSize="13sp" android:textStyle="bold" />
            <ImageView android:id="@+id/icon" android:layout_width="26dp" android:layout_height="26dp"
                android:scaleType="fitCenter" />
            <TextView android:id="@+id/wind" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="4dp" android:singleLine="true" android:textColor="@color/widget_fg"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
